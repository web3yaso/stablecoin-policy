{
  "name": "gov-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:phase0": "node --import tsx scripts/evals/run-phase0.ts",
    "eval:phase1": "node --import tsx scripts/evals/run-phase1.ts",
    "eval:phase2": "node --import tsx scripts/evals/run-phase2.ts",
    "spec:phase2:typecheck": "npx --yes @informalsystems/quint@0.32.0 typecheck specs/legalCorpusPublication.qnt && npx --yes @informalsystems/quint@0.32.0 typecheck specs/legalCorpusPublication_test.qnt",
    "spec:phase2:test": "npx --yes @informalsystems/quint@0.32.0 test specs/legalCorpusPublication_test.qnt --main legalCorpusPublication_test --match '.*Test$'",
    "spec:phase2:simulate": "npx --yes @informalsystems/quint@0.32.0 run specs/legalCorpusPublication.qnt --main legalCorpusPublication --invariants verifiedSourceHasHumanReviewedEvidence reviewedClaimHasVerifiedDirectSupport publishedReleaseHasCurrentHumanApproval reviewedCoverageHasCompleteReviewedBaseline serviceRoleHasNoDirectCoverageWrite --witnesses sourceVerifiedWitness claimReviewedWitness releasePublishedWitness coverageReviewedWitness --max-steps 20",
    "spec:phase2": "npm run spec:phase2:typecheck && npm run spec:phase2:test && npm run spec:phase2:simulate",
    "db:phase2:start": "npx --yes supabase@2.111.0 start -x realtime,imgproxy,studio,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:phase2:stop": "npx --yes supabase@2.111.0 stop --no-backup",
    "test:db:phase2": "npx --yes supabase@2.111.0 test db --local supabase/tests",
    "storage:publish": "node --import tsx scripts/migrate/publish-phase1-data.ts",
    "storage:restore": "node --import tsx scripts/migrate/restore-release.ts",
    "storage:backup-metadata": "node --import tsx scripts/migrate/export-phase1-metadata.ts",
    "data:check": "node --import tsx scripts/ci/check-repository-data.ts",
    "audit:deps": "npm audit --audit-level=low",
    "asp:check": "tsx scripts/asp/check-paid-endpoint.ts",
    "blurbs:refresh": "tsx scripts/cleanup/refresh-blurbs.ts --force",
    "data:rebuild": "tsx scripts/build-placeholder.ts",
    "news:poll": "tsx scripts/sync/news-rss.ts",
    "legal:sources:ingest": "tsx scripts/sync/legal-official-sources.ts",
    "legal:sources:verify": "tsx scripts/review/legal-source-verification.ts",
    "legal:claims:review": "tsx scripts/review/legal-claim-review.ts",
    "legal:claims:draft": "tsx scripts/review/legal-claim-draft-import.ts",
    "legal:corpus:release": "tsx scripts/review/legal-corpus-release.ts",
    "legal:coverage:review": "tsx scripts/review/legal-coverage-review.ts",
    "news:sources:check": "tsx scripts/smoke/professional-sources-dryrun.ts",
    "smoke:phase2": "node --import tsx scripts/smoke/phase2-corpus.ts",
    "smoke:source-verification": "tsx scripts/smoke/source-verification.ts",
    "smoke:claim-review": "tsx scripts/smoke/claim-review.ts",
    "smoke:corpus-release": "tsx scripts/smoke/corpus-release.ts",
    "smoke:coverage-review": "tsx scripts/smoke/coverage-review.ts",
    "news:regen": "tsx scripts/sync/news-regen.ts",
    "cost:summary": "tsx scripts/reports/summarize-llm-cost.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "alipay-sdk": "^4.14.0",
    "cobe": "^2.0.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.38.0",
    "maplibre-gl": "^5.23.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grab": "^0.1.31",
    "react-simple-maps": "^1.0.0",
    "topojson-client": "^3.1.0",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "openai": "^7.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
