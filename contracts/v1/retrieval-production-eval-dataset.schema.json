{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stablecoinpolicy.com/contracts/v1/retrieval-production-eval-dataset.schema.json",
  "title": "Retrieval production eval dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evalAssurance",
    "datasetId",
    "sourceSnapshot",
    "generation",
    "independentCheck",
    "reviewerRef",
    "requiredChecklistTopics",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "datasetId": {
      "type": "string",
      "pattern": "^eval-dataset:[0-9a-f]{40}$"
    },
    "evalAssurance": {
      "enum": ["MACHINE_ASSURED", "HUMAN_REVIEWED"]
    },
    "sourceSnapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "generation": { "$ref": "#/$defs/agentProvenance" },
    "independentCheck": { "$ref": "#/$defs/agentProvenance" },
    "reviewerRef": { "type": ["string", "null"], "minLength": 1 },
    "requiredChecklistTopics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "checklistTopic",
          "query",
          "expectedProvisionIds"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$"
          },
          "checklistTopic": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "expectedProvisionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "manifestSha256"],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "agentProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "model",
        "promptTemplateId",
        "promptTemplateVersion",
        "parametersVersion",
        "artifactSha256"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$"
        },
        "model": { "type": "string", "minLength": 1 },
        "promptTemplateId": { "type": "string", "minLength": 1 },
        "promptTemplateVersion": { "type": "string", "minLength": 1 },
        "parametersVersion": { "type": "string", "minLength": 1 },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evalAssurance": { "const": "HUMAN_REVIEWED" } },
        "required": ["evalAssurance"]
      },
      "then": { "properties": { "reviewerRef": { "type": "string", "minLength": 1 } } }
    }
  ]
}
