{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/deterministic-rule-action-eval-report.schema.json",
  "title": "DeterministicRuleActionEvalReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "thresholds", "caseCount", "scopes", "results", "outcome", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "type": "string", "pattern": "^deterministic-rule-action-eval:[0-9a-f]{32}$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCasesPerScope", "statusReasonExactMatchRate", "repeatedRunExactMatchRate", "ragIsolationRate", "safeDegradationRate", "materialActionGroundingRate"],
      "properties": {
        "minimumCasesPerScope": { "const": 4 },
        "statusReasonExactMatchRate": { "const": 1 },
        "repeatedRunExactMatchRate": { "const": 1 },
        "ragIsolationRate": { "const": 1 },
        "safeDegradationRate": { "const": 1 },
        "materialActionGroundingRate": { "const": 1 }
      }
    },
    "caseCount": { "type": "integer", "minimum": 1 },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeId", "jurisdictionCode", "assetId", "playbookId", "caseCount", "statusReasonExactMatchRate", "repeatedRunExactMatchRate", "ragIsolationRate", "safeDegradationRate", "materialActionGroundingRate", "deterministicRuleActionGatePassed"],
        "properties": {
          "scopeId": { "type": "string", "minLength": 1 },
          "jurisdictionCode": { "type": "string", "minLength": 1 },
          "assetId": { "type": ["string", "null"] },
          "playbookId": { "type": "string", "minLength": 1 },
          "caseCount": { "type": "integer", "minimum": 1 },
          "statusReasonExactMatchRate": { "$ref": "#/$defs/rate" },
          "repeatedRunExactMatchRate": { "$ref": "#/$defs/rate" },
          "ragIsolationRate": { "$ref": "#/$defs/rate" },
          "safeDegradationRate": { "$ref": "#/$defs/rate" },
          "materialActionGroundingRate": { "$ref": "#/$defs/rate" },
          "deterministicRuleActionGatePassed": { "type": "boolean" }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "scopeId", "inputArtifactSha256", "statusReasonExactMatch", "repeatedRunExactMatch", "ragIsolationValid", "safeDegradationValid", "materialActionGroundingValid", "exactMatch"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "scopeId": { "type": "string", "minLength": 1 },
          "inputArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "statusReasonExactMatch": { "type": "boolean" },
          "repeatedRunExactMatch": { "type": "boolean" },
          "ragIsolationValid": { "type": "boolean" },
          "safeDegradationValid": { "type": "boolean" },
          "materialActionGroundingValid": { "type": "boolean" },
          "exactMatch": { "type": "boolean" }
        }
      }
    },
    "outcome": { "enum": ["PASSED", "FAILED"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "rate": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
