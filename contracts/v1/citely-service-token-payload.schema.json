{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/citely-service-token-payload.schema.json",
  "title": "Citely Service Token Payload v1",
  "type": "object",
  "required": ["iss", "aud", "sub", "iat", "nbf", "exp", "jti", "entitlement"],
  "additionalProperties": false,
  "properties": {
    "iss": { "const": "https://www.citely.info" },
    "aud": { "const": "stablecoin-policy" },
    "sub": { "const": "citely:playbook-service" },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "entitlement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "domain", "scope", "playbookId", "packageId"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "domain": { "const": "stablecoin" },
            "scope": { "const": "playbook:execute" },
            "playbookId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
            },
            "packageId": {
              "type": "string",
              "pattern": "^package:[a-z0-9-]+:[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "domain", "scope", "playbookId"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "domain": { "const": "stablecoin" },
            "scope": { "const": "playbook:execute" },
            "playbookId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "domain", "scope", "packageId"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "domain": { "const": "stablecoin" },
            "scope": { "const": "playbook:read" },
            "packageId": {
              "type": "string",
              "pattern": "^package:[a-z0-9-]+:[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "domain", "scope"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            },
            "domain": { "const": "stablecoin" },
            "scope": { "const": "evidence:search" }
          }
        }
      ]
    }
  }
}
