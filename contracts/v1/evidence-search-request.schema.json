{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/evidence-search-request.schema.json",
  "title": "EvidenceSearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "filters"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "topK": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictionCodes",
        "topics",
        "asOf",
        "sourceTypes",
        "assuranceTier",
        "corpusReleaseId",
        "indexReleaseId"
      ],
      "properties": {
        "jurisdictionCodes": { "type": "array", "items": { "type": "string" } },
        "topics": { "type": "array", "items": { "type": "string" } },
        "asOf": { "type": "string", "format": "date-time" },
        "sourceTypes": { "type": "array", "items": { "type": "string" } },
        "assuranceTier": { "enum": ["PROVISIONAL", "HUMAN_REVIEWED"] },
        "corpusReleaseId": { "type": ["string", "null"] },
        "indexReleaseId": { "type": ["string", "null"] }
      }
    }
  }
}
