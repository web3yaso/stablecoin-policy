{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stablecoin-policy.citely.info/contracts/v1/changes-response.schema.json",
  "title": "ChangesResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changes", "nextCursor"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "eventType", "title", "observedAt", "effectiveAt", "beforeVersionId", "afterVersionId", "authorityId", "authorityName", "claimId", "impactType", "jurisdictionCode", "topic"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "eventType": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "effectiveAt": { "type": ["string", "null"], "format": "date-time" },
          "beforeVersionId": { "type": ["string", "null"] },
          "afterVersionId": { "type": ["string", "null"] },
          "authorityId": { "type": "string", "minLength": 1 },
          "authorityName": { "type": "string", "minLength": 1 },
          "claimId": { "type": "string", "minLength": 1 },
          "impactType": { "type": "string", "minLength": 1 },
          "jurisdictionCode": { "type": "string", "minLength": 2 },
          "topic": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextCursor": { "type": ["string", "null"] }
  }
}
