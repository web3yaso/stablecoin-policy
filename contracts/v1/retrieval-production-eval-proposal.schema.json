{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stablecoinpolicy.com/contracts/v1/retrieval-production-eval-proposal.schema.json",
  "title": "Retrieval production eval proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proposalId", "snapshotId", "snapshotManifestSha256",
    "generator", "requiredChecklistTopics", "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "proposalId": { "$ref": "#/$defs/identifier" },
    "snapshotId": { "$ref": "#/$defs/identifier" },
    "snapshotManifestSha256": { "$ref": "#/$defs/sha256" },
    "generator": { "$ref": "#/$defs/agent" },
    "requiredChecklistTopics": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "checklistTopic", "query", "expectedProvisionIds"],
        "properties": {
          "caseId": { "$ref": "#/$defs/identifier" },
          "checklistTopic": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "expectedProvisionIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["agentId", "model", "promptTemplateId", "promptTemplateVersion", "parametersVersion"],
      "properties": {
        "agentId": { "$ref": "#/$defs/identifier" },
        "model": { "type": "string", "minLength": 1 },
        "promptTemplateId": { "type": "string", "minLength": 1 },
        "promptTemplateVersion": { "type": "string", "minLength": 1 },
        "parametersVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
