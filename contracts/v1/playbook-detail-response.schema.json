{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/playbook-detail-response.schema.json",
  "title": "PlaybookDetailResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "playbook"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playbookId", "name", "version", "templateVersion", "description",
        "capabilities", "intakeSchema", "assuranceNote"
      ],
      "properties": {
        "playbookId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capabilityId", "title"],
            "properties": {
              "capabilityId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        },
        "intakeSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema", "type", "title", "additionalProperties", "required",
            "properties"
          ],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "const": "object" },
            "title": { "type": "string", "minLength": 1 },
            "additionalProperties": { "const": false },
            "required": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "operatorJurisdiction", "targetJurisdiction", "activities", "asset"
                ]
              },
              "allOf": [
                { "contains": { "const": "operatorJurisdiction" } },
                { "contains": { "const": "targetJurisdiction" } },
                { "contains": { "const": "activities" } }
              ]
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operatorJurisdiction", "targetJurisdiction", "activities"
              ],
              "properties": {
                "operatorJurisdiction": { "$ref": "#/$defs/stringField" },
                "targetJurisdiction": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "title", "const"],
                  "properties": {
                    "type": { "const": "string" },
                    "title": { "type": "string", "minLength": 1 },
                    "const": { "const": "EEA" }
                  }
                },
                "activities": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type", "title", "minItems", "uniqueItems", "items"
                  ],
                  "properties": {
                    "type": { "const": "array" },
                    "title": { "type": "string", "minLength": 1 },
                    "minItems": { "const": 1 },
                    "uniqueItems": { "const": true },
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["oneOf"],
                      "properties": {
                        "oneOf": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["const", "title"],
                            "properties": {
                              "const": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                              "title": { "type": "string", "minLength": 1 }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "asset": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type", "title", "additionalProperties", "required", "properties"
                  ],
                  "properties": {
                    "type": { "const": "object" },
                    "title": { "type": "string", "minLength": 1 },
                    "additionalProperties": { "const": false },
                    "required": {
                      "const": ["symbol", "networks"]
                    },
                    "properties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["symbol", "networks"],
                      "properties": {
                        "symbol": { "$ref": "#/$defs/stringField" },
                        "networks": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type", "title", "minItems", "uniqueItems", "items"
                          ],
                          "properties": {
                            "type": { "const": "array" },
                            "title": { "type": "string", "minLength": 1 },
                            "minItems": { "const": 1 },
                            "uniqueItems": { "const": true },
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["type", "minLength"],
                              "properties": {
                                "type": { "const": "string" },
                                "minLength": { "const": 1 }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "assuranceNote": {
          "const": "Evaluations run on provisional machine-assured evidence and are research, not legal advice."
        }
      }
    }
  },
  "$defs": {
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "minLength"],
      "properties": {
        "type": { "const": "string" },
        "title": { "type": "string", "minLength": 1 },
        "minLength": { "const": 1 }
      }
    }
  }
}
