{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/provisional-claim.schema.json",
  "title": "ProvisionalClaimResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "claim", "releaseId", "assuranceLevel", "reviewStatus",
    "confidence", "asOf", "knowledgeCutoff", "sourceVersion", "citations",
    "limitations", "counselTriggers"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "jurisdictionCode", "topic", "proposition", "legalStatus", "effectiveFrom", "effectiveTo"],
      "properties": {
        "claimId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,160}$" },
        "jurisdictionCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$" },
        "topic": { "type": "string", "minLength": 1 },
        "proposition": { "type": "string", "minLength": 1 },
        "legalStatus": { "enum": ["REQUIREMENT", "PERMISSION", "PROHIBITION", "EXEMPTION", "GUIDANCE", "UNDETERMINED"] },
        "effectiveFrom": { "type": "string", "format": "date-time" },
        "effectiveTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,160}$" },
    "assuranceLevel": { "const": "PROVISIONAL_PUBLISHED" },
    "reviewStatus": { "enum": ["PROVISIONAL", "HUMAN_REVIEWED"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "asOf": { "type": "string", "format": "date-time" },
    "knowledgeCutoff": { "type": "string", "format": "date-time" },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checksumSha256", "retrievedAt", "officialUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,160}$" },
        "checksumSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "officialUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provisionId", "locator"],
        "properties": {
          "provisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,200}$" },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "counselTriggers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
