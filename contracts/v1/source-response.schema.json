{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stablecoin-policy.citely.info/contracts/v1/source-response.schema.json",
  "title": "PublicSourceResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusReleaseId", "authority", "document", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "corpusReleaseId": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "name"],
      "properties": {
        "authorityId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "title", "documentType", "canonicalUrl"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "documentType": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "jurisdictionCode", "topic", "proposition", "legalStatus", "effectiveFrom", "effectiveTo", "citationId", "supportRelation", "exactLocator", "allowedExcerpt", "provisionId", "sourceVersionId", "versionChecksumSha256", "publishedAt", "retrievedAt", "verifiedAt"],
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "jurisdictionCode": { "type": "string", "minLength": 2 },
          "topic": { "type": "string", "minLength": 1 },
          "proposition": { "type": "string", "minLength": 1 },
          "legalStatus": { "type": "string", "minLength": 1 },
          "effectiveFrom": { "type": "string", "format": "date-time" },
          "effectiveTo": { "type": ["string", "null"], "format": "date-time" },
          "citationId": { "type": "string", "minLength": 1 },
          "supportRelation": { "enum": ["DIRECT_SUPPORT", "INDIRECT_SUPPORT", "CONTRADICTS"] },
          "exactLocator": { "type": "string", "minLength": 1 },
          "allowedExcerpt": { "type": ["string", "null"] },
          "provisionId": { "type": "string", "minLength": 1 },
          "sourceVersionId": { "type": "string", "minLength": 1 },
          "versionChecksumSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
