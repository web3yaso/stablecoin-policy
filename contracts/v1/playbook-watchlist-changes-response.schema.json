{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/playbook-watchlist-changes-response.schema.json",
  "title": "PlaybookWatchlistChangesResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "watchlistId", "packageId", "items", "nextCursor", "hasMore"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "watchlistId": {
      "type": "string",
      "pattern": "^watchlist:[0-9a-f]{32}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^package:[a-z0-9-]+:[0-9a-f]{16}$"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/changeDelta" }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "hasMore": { "type": "boolean" }
  },
  "$defs": {
    "changeDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deltaId", "cursor", "watchlistId", "packageId", "event",
        "evidenceChanges", "status", "packageAssuranceReviewStatus", "actions",
        "requiredCustomerResponse", "createdAt"
      ],
      "properties": {
        "deltaId": {
          "type": "string",
          "pattern": "^delta:[0-9a-f]{32}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "watchlistId": {
          "type": "string",
          "pattern": "^watchlist:[0-9a-f]{32}$"
        },
        "packageId": {
          "type": "string",
          "pattern": "^package:[a-z0-9-]+:[0-9a-f]{16}$"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId", "eventType", "title", "publishedAt", "effectiveAt",
            "beforeVersionId", "afterVersionId"
          ],
          "properties": {
            "eventId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{2,160}$"
            },
            "eventType": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "publishedAt": { "type": "string", "format": "date-time" },
            "effectiveAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "beforeVersionId": { "type": ["string", "null"], "minLength": 1 },
            "afterVersionId": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "evidenceChanges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "impactType"],
            "properties": {
              "claimId": { "type": "string", "minLength": 1 },
              "impactType": {
                "enum": ["MAY_AFFECT", "INVALIDATES", "SUPERSEDES", "DEADLINE"]
              }
            }
          }
        },
        "status": { "const": "REVIEW_REQUIRED" },
        "packageAssuranceReviewStatus": {
          "enum": ["PROVISIONAL", "HUMAN_REVIEWED"]
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "REVIEW_EVIDENCE_CHANGE" },
            { "const": "REQUEST_PLAYBOOK_RERUN" }
          ],
          "items": false
        },
        "requiredCustomerResponse": { "const": "ACKNOWLEDGE_AND_RERUN" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
