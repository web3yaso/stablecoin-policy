{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy.citely.info/contracts/v1/monitoring-eval-report.schema.json",
  "title": "MonitoringEvalReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "thresholds", "caseCount", "knownAffectedPackageCount", "recalledPackageCount", "monitoringRecall", "criticalMissCount", "falsePositiveCount", "exactCaseAccuracy", "scopes", "results", "outcome", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "type": "string", "pattern": "^monitoring-eval:[0-9a-f]{32}$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumKnownAffectedPackages", "minimumMonitoringRecall", "maximumCriticalMisses", "maximumFalsePositives"],
      "properties": {
        "minimumKnownAffectedPackages": { "const": 1 },
        "minimumMonitoringRecall": { "const": 0.95 },
        "maximumCriticalMisses": { "const": 0 },
        "maximumFalsePositives": { "const": 0 }
      }
    },
    "caseCount": { "type": "integer", "minimum": 1 },
    "knownAffectedPackageCount": { "type": "integer", "minimum": 0 },
    "recalledPackageCount": { "type": "integer", "minimum": 0 },
    "monitoringRecall": { "type": "number", "minimum": 0, "maximum": 1 },
    "criticalMissCount": { "type": "integer", "minimum": 0 },
    "falsePositiveCount": { "type": "integer", "minimum": 0 },
    "exactCaseAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeId", "jurisdictionCode", "assetId", "playbookId", "caseCount", "knownAffectedPackageCount", "recalledPackageCount", "monitoringRecall", "criticalMissCount", "falsePositiveCount", "exactCaseAccuracy", "monitoringGatePassed"],
        "properties": {
          "scopeId": { "type": "string", "minLength": 1 },
          "jurisdictionCode": { "type": "string" },
          "assetId": { "type": ["string", "null"] },
          "playbookId": { "type": "string" },
          "caseCount": { "type": "integer", "minimum": 1 },
          "knownAffectedPackageCount": { "type": "integer", "minimum": 0 },
          "recalledPackageCount": { "type": "integer", "minimum": 0 },
          "monitoringRecall": { "type": "number", "minimum": 0, "maximum": 1 },
          "criticalMissCount": { "type": "integer", "minimum": 0 },
          "falsePositiveCount": { "type": "integer", "minimum": 0 },
          "exactCaseAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
          "monitoringGatePassed": { "type": "boolean" }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "scopeId", "expectedAffectedPackageIds", "actualAffectedPackageIds", "missedPackageIds", "falsePositivePackageIds", "exactMatch"],
        "properties": {
          "caseId": { "type": "string" },
          "scopeId": { "type": "string" },
          "expectedAffectedPackageIds": { "$ref": "#/$defs/packageIds" },
          "actualAffectedPackageIds": { "$ref": "#/$defs/packageIds" },
          "missedPackageIds": { "$ref": "#/$defs/packageIds" },
          "falsePositivePackageIds": { "$ref": "#/$defs/packageIds" },
          "exactMatch": { "type": "boolean" }
        }
      }
    },
    "outcome": { "enum": ["PASSED", "FAILED"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "packageIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^package:[a-z0-9-]+:[0-9a-f]{16}$" }
    }
  }
}
