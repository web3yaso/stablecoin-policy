# Existing data sync keys
CONGRESS_API_KEY=
STATE_API_KEY=
# Optional. Both fall back to another configured api.data.gov key.
GOVINFO_API_KEY=
REGULATIONS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna

# Leave empty/0 for continuous monitoring. Set a positive integer only for
# time-boxed evaluations.
NEWS_POLL_MAX_DAYS=

# x402 reports API
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_X402_BASE_URL=https://web3.okx.com
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_NETWORK=eip155:1952

# agentcash discovery ownership proof(s), comma-separated.
# Used to claim/register this endpoint on X402Scan / MppScan.
X402_OWNERSHIP_PROOFS=

# Report content encryption
# Generate a local key with:
#   openssl rand -base64 32
REPORTS_ENCRYPTION_KEY=
# file (default), dual (serve file and compare Supabase), or supabase.
STABLECOIN_POLICY_DATA_BACKEND=file
# Server-only external storage credentials. Never expose the service-role key
# through NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=policy-reports
SUPABASE_DATASETS_BUCKET=policy-datasets
SUPABASE_SOURCES_BUCKET=policy-sources
POLICY_CACHE_FRESH_SECONDS=300
POLICY_CACHE_MAX_STALE_SECONDS=86400
POLICY_STORAGE_TIMEOUT_MS=8000
POLICY_DUAL_READ_STRICT=0

# Vercel KV payment logging
KV_REST_API_URL=
KV_REST_API_TOKEN=

# x402 verification script only. TESTNET ONLY; never use a mainnet private key.
TEST_BUYER_PRIVATE_KEY=
REPORTS_API_BASE_URL=http://localhost:3000
BASE_SEPOLIA_RPC_URL=
# Optional: persist per-response token usage and USD cost somewhere else.
# Defaults to data/operations/llm-cost.jsonl (gitignored).
LLM_COST_LOG_PATH=
LLM_COST_RUN_ID=
